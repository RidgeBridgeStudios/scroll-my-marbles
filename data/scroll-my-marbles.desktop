[Desktop Entry]
Name=Scroll My Marbles
Comment=Wheel-less scrolling for the Logitech TrackMan Marble (T-BC21) and compatible trackballs.
Exec=scroll-my-marbles
Icon=scroll-my-marbles
Terminal=false
Type=Application
Categories=Utility;Settings;HardwareSettings;
Keywords=trackball;marble;scroll;logitech;mouse;wheel;
StartupNotify=true
X-GNOME-UsesNotifications=true
Actions=Settings;

[Desktop Action Settings]
Name=Settings
Exec=scroll-my-marbles --settings
